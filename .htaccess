# ============================================================
#  Kaweera v1.0.2 — Apache / LiteSpeed .htaccess
#  Optimized for Hostinger Shared & Cloud Hosting (public_html)
# ============================================================

# -------- 1. Force HTTPS --------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# -------- 2. SPA Fallback --------
# Serve existing files/directories as-is (assets, _expo, manager, favicon, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Exclude the /manager/ admin path from SPA rewrite
RewriteCond %{REQUEST_URI} !^/manager
RewriteRule ^(.*)$ /index.html [L,QSA]

# -------- 3. Security Headers --------
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header set X-Content-Type-Options "nosniff"
  # Prevent embedding in iframes from other domains
  Header set X-Frame-Options "SAMEORIGIN"
  # Control referrer data
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Permissions policy — restrict sensitive APIs
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Strict Transport Security (enable after verifying HTTPS works)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# -------- 4. Compression --------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml text/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2 font/woff font/ttf application/font-woff2
</IfModule>

# -------- 5. Browser Caching --------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — short cache (content may change)
  ExpiresByType text/html "access plus 1 hour"

  # JavaScript bundles — long cache (hashed filenames)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # CSS
  ExpiresByType text/css "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Images
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"

  # JSON
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

# -------- 6. Cache-Control Headers --------
<IfModule mod_headers.c>
  # Hashed JS/CSS bundles — immutable
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fonts — long cache
  <FilesMatch "\.(woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images — long cache
  <FilesMatch "\.(png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML — short cache, revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# -------- 7. MIME Types --------
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/x-icon .ico
  AddType application/json .json
</IfModule>

# -------- 8. Deny access to dotfiles (except this .htaccess) --------
<FilesMatch "^\.(?!htaccess)">
  Require all denied
</FilesMatch>

# -------- 9. Deny access to markdown and git metadata --------
<FilesMatch "\.(md|markdown)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
